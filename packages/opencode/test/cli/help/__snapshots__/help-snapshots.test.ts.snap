// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`opencode CLI help-text snapshots every documented command emits stable help text: opencode acp --help 1`] = `
"triglavcode acp

запустить сервер ACP (Agent Client Protocol)

Options:
  -h, --help         show help                                                             [boolean]
  -v, --version      show version number                                                   [boolean]
      --print-logs   print logs to stderr                                                  [boolean]
      --log-level    log level                  [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure         run without external plugins                                          [boolean]
      --port         порт для прослушивания                                    [number] [default: 0]
      --hostname     имя хоста для прослушивания                     [string] [default: "127.0.0.1"]
      --mdns         включить обнаружение через mDNS (по умолчанию хост 0.0.0.0)
                                                                          [boolean] [default: false]
      --mdns-domain  своё доменное имя для mDNS (по умолчанию: opencode.local)
                                                                [string] [default: "opencode.local"]
      --cors         дополнительные домены, разрешённые для CORS               [array] [default: []]
      --cwd          рабочий каталог [string] [default: "<HOME>"]"
`;

exports[`opencode CLI help-text snapshots every documented command emits stable help text: opencode mcp --help 1`] = `
"triglavcode mcp

управление серверами MCP (Model Context Protocol)

Commands:
  triglavcode mcp add [name]     добавить MCP-сервер
  triglavcode mcp list           показать MCP-серверы и их статус                      [aliases: ls]
  triglavcode mcp auth [name]    авторизоваться на MCP-сервере с поддержкой OAuth
  triglavcode mcp logout [name]  удалить учётные данные OAuth для MCP-сервера
  triglavcode mcp debug <name>   отладка OAuth-подключения к MCP-серверу

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                           [boolean]"
`;

exports[`opencode CLI help-text snapshots every documented command emits stable help text: opencode attach --help 1`] = `
"triglavcode attach <url>

подключиться к запущенному серверу opencode

Positionals:
  url  http://localhost:4096                                                     [string] [required]

Options:
  -h, --help          show help                                                            [boolean]
  -v, --version       show version number                                                  [boolean]
      --print-logs    print logs to stderr                                                 [boolean]
      --log-level     log level                 [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure          run without external plugins                                         [boolean]
      --dir           directory to run in                                                   [string]
  -c, --continue      продолжить последнюю сессию                                          [boolean]
  -s, --session       ID сессии для продолжения                                             [string]
      --fork          создать форк сессии при продолжении (используйте с --continue или --session)
                                                                                           [boolean]
  -p, --password      пароль basic auth (по умолчанию OPENCODE_SERVER_PASSWORD)             [string]
  -u, --username      имя пользователя basic auth (по умолчанию OPENCODE_SERVER_USERNAME или
                      'opencode')                                                           [string]
      --mini          запустить минимальный интерактивный интерфейс       [boolean] [default: false]
      --no-replay     отключить воспроизведение истории мини-сессии при возобновлении и изменении
                      размера                                                              [boolean]
      --replay-limit  ограничить видимое мини-воспроизведение N последними сообщениями      [number]"
`;

exports[`opencode CLI help-text snapshots every documented command emits stable help text: opencode run --help 1`] = `
"triglavcode run [message..]

запустить opencode с сообщением

Positionals:
  message  сообщение для отправки                                              [array] [default: []]

Options:
  -h, --help         show help                                                             [boolean]
  -v, --version      show version number                                                   [boolean]
      --print-logs   print logs to stderr                                                  [boolean]
      --log-level    log level                  [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure         run without external plugins                                          [boolean]
      --command      команда для запуска; аргументы передаются через message                [string]
  -c, --continue     продолжить последнюю сессию                                           [boolean]
  -s, --session      ID сессии для продолжения                                              [string]
      --fork         создать форк сессии перед продолжением (требуется --continue или --session)
                                                                                           [boolean]
      --share        поделиться сессией                                                    [boolean]
  -m, --model        модель в формате провайдер/модель                                      [string]
      --agent        используемый агент                                                     [string]
      --format       формат: default (форматированный) или json (сырые JSON-события)
                                          [string] [choices: "default", "json"] [default: "default"]
  -f, --file         файл(ы) для прикрепления к сообщению                                    [array]
      --title        заголовок сессии (по умолчанию — усечённый запрос)                     [string]
      --attach       подключиться к запущенному серверу opencode (например, http://localhost:4096)
                                                                                            [string]
  -p, --password     пароль basic auth (по умолчанию OPENCODE_SERVER_PASSWORD)              [string]
  -u, --username     имя пользователя basic auth (по умолчанию OPENCODE_SERVER_USERNAME или
                     'opencode')                                                            [string]
      --dir          каталог для запуска; путь на удалённом сервере при подключении         [string]
      --port         порт локального сервера (по умолчанию случайный)                       [number]
      --variant      вариант модели (усилие рассуждения провайдера, например high, max, minimal)
                                                                                            [string]
      --thinking     показывать блоки размышлений                                          [boolean]
  -i, --interactive  запустить в режиме прямого интерактивного разделённого футера
                                                                          [boolean] [default: false]
      --auto         автоматически одобрять разрешения, не запрещённые явно (опасно!)
                                                                          [boolean] [default: false]"
`;

exports[`opencode CLI help-text snapshots every documented command emits stable help text: opencode debug --help 1`] = `
"triglavcode debug

инструменты отладки и диагностики

Commands:
  triglavcode debug config        показать итоговую конфигурацию
  triglavcode debug lsp           утилиты отладки LSP
  triglavcode debug rg            утилиты отладки ripgrep
  triglavcode debug file          утилиты отладки файловой системы
  triglavcode debug scrap         показать все известные проекты
  triglavcode debug skill         показать все доступные навыки
  triglavcode debug snapshot      утилиты отладки снапшотов
  triglavcode debug startup       показать время запуска
  triglavcode debug agent <name>  показать конфигурацию агента
  triglavcode debug v2            отладка каталога v2 и встроенных плагинов
  triglavcode debug info          показать отладочную информацию
  triglavcode debug paths         показать глобальные пути (data, config, cache, state)
  triglavcode debug wait          ждать бесконечно (для отладки)

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                           [boolean]"
`;

