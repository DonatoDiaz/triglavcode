{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "permission": {},
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "plugin": [
    "./plugins/freelance-radar/index.js",
    "./plugins/usage-analytics/index.js",
    "./plugins/auto-learn/index.js",
    "./plugins/auto-close-issues/index.js",
    "./plugins/rag-auto-context/index.js",
    "./plugins/decision-log/index.js",
  ],
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
